{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stick-it-to-the-stickman-wiki-production",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "stickittothestickmanwiki.space",
      "custom_domain": true
    }
  ]
}
